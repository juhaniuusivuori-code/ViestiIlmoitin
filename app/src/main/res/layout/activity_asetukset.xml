<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ASETUKSET"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1A237E"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Valitse mitä viestejä sovellus kuuntelee ja ilmoittaa:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <!-- 1. WHATSUP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WHATSUP"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />

        <Button
            android:id="@+id/btnToggleWhatsApp"
            android:layout_width="135dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="PÄÄLLÄ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />
    </LinearLayout>

    <!-- 2. MESSENGER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MESSENGER"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1565C0" />

        <Button
            android:id="@+id/btnToggleMessenger"
            android:layout_width="135dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="PÄÄLLÄ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />
    </LinearLayout>

    <!-- 3. SMS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SMS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnToggleSms"
            android:layout_width="135dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="PÄÄLLÄ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />
    </LinearLayout>

    <!-- 4. S-POSTI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="S-POSTI"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D81B60" />

        <Button
            android:id="@+id/btnToggleEmail"
            android:layout_width="135dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="PÄÄLLÄ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />
    </LinearLayout>

    <!-- OHJE-painike -->
    <Button
        android:id="@+id/btnHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="O H J E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#37474F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- LOKI-painike -->
    <Button
        android:id="@+id/btnLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="L O K I"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#546E7A"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- PALAA TAKAISIN -painike -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="PALAA TAKAISIN"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF" />

</LinearLayout>
