<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="7dp"
    android:background="#F8F9FA">

    <!-- 0. PÄÄLLÄ / POIS -PÄÄKYTKIN YLIMMÄISEKSI (Korkea palkki, teksti ei katoa reunan alle, ilman hymiöitä) -->
    <Button
        android:id="@+id/btnMasterSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="SOVELLUS ON PÄÄLLÄ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:layout_marginBottom="3dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PUHUVA VIESTI-ILMOITIN"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1A237E"
        android:layout_marginBottom="3dp" />

    <!-- 1. Tekstiviesti: Ennen nimeä ja nimen jälkeen rinnakkain -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ennen nimeä:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <EditText
                android:id="@+id/editPrefix"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="#FFFFFF"
                android:padding="5dp"
                android:hint="VIESTI TULI "
                android:singleLine="true"
                android:inputType="text"
                android:scrollHorizontally="true"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nimen jälkeen:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <EditText
                android:id="@+id/editSuffix"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="#FFFFFF"
                android:padding="5dp"
                android:hint="(valinnainen)"
                android:singleLine="true"
                android:inputType="text"
                android:scrollHorizontally="true"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Tuntematon numero KOKO LEVEYDELLÄ (mahtuu pitkäkin teksti leikkaantumatta) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tuntematon numero:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/editUnknown"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#FFFFFF"
        android:padding="5dp"
        android:hint="VIESTI NUMEROSTA "
        android:singleLine="true"
        android:inputType="text"
        android:scrollHorizontally="true"
        android:textSize="13sp"
        android:layout_marginBottom="3dp" />

    <!-- 3. WhatsApp ja Messenger rinnakkain -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatsApp-huuto:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />
            <EditText
                android:id="@+id/editWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="#FFFFFF"
                android:padding="5dp"
                android:hint="WHATSUP VIESTI"
                android:singleLine="true"
                android:inputType="text"
                android:scrollHorizontally="true"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messenger-huuto:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />
            <EditText
                android:id="@+id/editMessenger"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="#FFFFFF"
                android:padding="5dp"
                android:hint="MESSENGER VIESTI"
                android:singleLine="true"
                android:inputType="text"
                android:scrollHorizontally="true"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Sähköposti-huuto KOKO LEVEYDELLÄ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sähköposti-huuto:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#D81B60" />

    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#FFFFFF"
        android:padding="5dp"
        android:hint="SÄHKÖPOSTI"
        android:singleLine="true"
        android:inputType="text"
        android:scrollHorizontally="true"
        android:textSize="13sp"
        android:layout_marginBottom="3dp" />

    <!-- 5. Alasvetovalikot rinnakkain -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toistokerrat (kaikki):"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <Spinner
                android:id="@+id/spinnerRepeats"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:background="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toistoväli:"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <Spinner
                android:id="@+id/spinnerInterval"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:background="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Nappi ilmoitusluvan myöntämiseen (Ilman hymiöitä) -->
    <Button
        android:id="@+id/btnNotificationPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:padding="4dp"
        android:text="SALLI ILMOITUKSET\n(Paina tästä ja valitse: Viesti-Ilmoitin)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#FF8F00"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="3dp" />

    <!-- 7. Kokeile ääntä (Korkea palkki, ilman hymiöitä) -->
    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="KOKEILE ÄÄNTÄ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00897B"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp" />

    <!-- 8. Asetukset-sivun avauspainike (OHJE, LOKI ja ohjelmakohtaiset PÄÄLLÄ/POIS-kytkimet) -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="A S E T U K S E T"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#37474F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="6dp" />

    <!-- 9. VOLUME liukusäädin -->
    <TextView
        android:id="@+id/tvVolumeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ÄÄNENVOIMAKKUUS: 100 %"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="1dp" />

    <SeekBar
        android:id="@+id/seekBarVolume"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:max="100"
        android:progress="100"
        android:layout_marginBottom="6dp" />

    <!-- 10. ALIMMAISEKSI: Tallenna asetukset VOLUMEN alle (Korkea ja selkeä palkki, ilman hymiöitä) -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="TALLENNA ASETUKSET"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF" />

</LinearLayout>
