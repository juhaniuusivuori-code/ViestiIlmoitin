<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PUHUVA VIESTI-ILMOITIN"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1A237E"
        android:layout_marginBottom="12dp" />

    <!-- Ennen nimeä -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Teksti ennen nimeä:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/editPrefix"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:hint="esim. VIESTI TULI "
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- Nimen jälkeen -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2. Teksti nimen jälkeen:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/editSuffix"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:hint="(voi jättää tyhjäksi)"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- Tuntematon numero -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3. Tuntematon numero:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/editUnknown"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:hint="esim. VIESTI NUMEROSTA "
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <!-- Alasvetovalikot rinnakkain -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toistokerrat:"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <Spinner
                android:id="@+id/spinnerRepeats"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toistoväli:"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <Spinner
                android:id="@+id/spinnerInterval"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Iso Testaa-nappi -->
    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🔊  KOKEILE ÄÄNTÄ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#00897B"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Iso Tallenna-nappi -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="💾  TALLENNA ASETUKSET"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF" />

</LinearLayout>
